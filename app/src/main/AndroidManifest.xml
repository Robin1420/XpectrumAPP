<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XpectrumAPP"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- 🏠 PANTALLA DE BIENVENIDA (LAUNCHER) -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:label="Bienvenido"
            android:theme="@style/Theme.XpectrumAPP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✈️ PANTALLA DE VUELOS -->
        <activity
            android:name=".VuelosActivity"
            android:exported="false"
            android:label="Vuelos Programados"
            android:theme="@style/Theme.XpectrumAPP"
            android:parentActivityName=".WelcomeActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".WelcomeActivity" />
        </activity>

        <!-- 📱 PANTALLA DE ESCÁNER QR -->
        <activity
            android:name=".QRScannerActivity"
            android:exported="false"
            android:label="Escáner QR"
            android:theme="@style/Theme.XpectrumAPP"
            android:parentActivityName=".VuelosActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".VuelosActivity" />
        </activity>

        <!-- 🎫 PANTALLA DE DETALLE DEL BOLETO -->
        <activity
            android:name=".BoletoDetailActivity"
            android:exported="false"
            android:label="Detalle del Boleto"
            android:theme="@style/Theme.XpectrumAPP"
            android:parentActivityName=".QRScannerActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".QRScannerActivity" />
        </activity>

        <!-- 📷 ACTIVIDAD QR SCANNER (LIBRERÍA) -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

    </application>

</manifest>