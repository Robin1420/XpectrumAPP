<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Esquina superior izquierda -->
    <item android:top="0dp" android:left="0dp" android:right="160dp" android:bottom="160dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#667eea" />
            <corners android:topLeftRadius="12dp" />
        </shape>
    </item>

    <!-- Esquina superior derecha -->
    <item android:top="0dp" android:right="0dp" android:left="160dp" android:bottom="160dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#667eea" />
            <corners android:topRightRadius="12dp" />
        </shape>
    </item>

    <!-- Esquina inferior izquierda -->
    <item android:bottom="0dp" android:left="0dp" android:right="160dp" android:top="160dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#667eea" />
            <corners android:bottomLeftRadius="12dp" />
        </shape>
    </item>

    <!-- Esquina inferior derecha -->
    <item android:bottom="0dp" android:right="0dp" android:left="160dp" android:top="160dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#667eea" />
            <corners android:bottomRightRadius="12dp" />
        </shape>
    </item>
</layer-list>