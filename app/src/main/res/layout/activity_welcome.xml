<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:gravity="center"
    android:padding="32dp">

    <!-- Logo Principal -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="24dp"
        android:padding="10dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:clipToOutline="true"
            android:background="@drawable/rounded_imageview" />

    </FrameLayout>

    <!-- Título de Bienvenida -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Bienvenido a Xpectrum!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu aplicación para gestionar vuelos y escanear boletos de forma rápida y segura"
        android:textSize="16sp"
        android:textColor="#E2E8F0"
        android:textAlignment="center"
        android:layout_marginBottom="48dp"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="16dp" />

    <!-- Botón Continuar -->
    <Button
        android:id="@+id/btnContinuar"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="CONTINUAR"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_scan_background"
        android:elevation="8dp"
        android:layout_marginTop="32dp" />

    <!-- Información adicional -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Versión 1.0"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginTop="32dp" />

</LinearLayout>