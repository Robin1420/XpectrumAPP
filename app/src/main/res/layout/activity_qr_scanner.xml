<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">



    <!-- Área principal de contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Card principal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="35dp"
                    android:gravity="center">

                    <!-- Título del card -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escanear Boleto"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#2D3748"
                        android:layout_marginBottom="16dp" />

                    <!-- Descripción -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escanea el código QR del boleto para\nverificar su validez"
                        android:textSize="18sp"
                        android:textColor="#718096"
                        android:textAlignment="center"
                        android:layout_marginBottom="40dp"
                        android:lineSpacingExtra="4dp" />

                    <!-- Marco de escaneo simulado -->
                    <FrameLayout
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_marginBottom="40dp">

                        <!-- Fondo del marco -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/scan_frame_background" />

                        <!-- Icono QR en el centro -->
                        <ImageView
                            android:layout_width="260dp"
                            android:layout_height="260dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icon_qr" />


                    </FrameLayout>



                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnEscanear"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:text="Escanear QR"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_scan_background"
                    android:elevation="4dp" />

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Cargar QR"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/button_scan_background2"
                    android:elevation="0dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>